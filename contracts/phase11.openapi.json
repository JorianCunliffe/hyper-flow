{
  "openapi": "3.1.0",
  "info": {
    "title": "HyperFlow tenant controls and workspace API",
    "version": "2026-09-09.3",
    "description": "Phase 11 tenant-operation supplement. Existing business operations remain documented in the application API reference and phase contracts. This is not yet the final whole-product parity inventory."
  },
  "paths": {
    "/api/tenant": {
      "get": {
        "operationId": "readHyperFlowTenantControls",
        "description": "Administrator view. Hashes and plaintext credentials are omitted. API-client counts cover admitted scoped requests, excluding Firebase browser sessions and provider charges. With view=lifecycle, requires a current human owner or administrator and returns HyperFlow-owned lifecycle receipts. service=communications reads the separate service. dataset/revision/offset exports 512000-byte base64 chunks at a suspended revision, with whole-dataset and chunk SHA-256 hashes. Credentials and file contents are excluded.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative app-owned result; not proof of an external provider effect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, role or membership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version conflict or held operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request budget exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "service",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ]
      },
      "post": {
        "operationId": "changeHyperFlowTenantControls",
        "description": " With view=lifecycle, current human owners or administrators may request suspend/resume using requestId and revision. service=communications forwards the command with a human audit journal and returns the Communications-owned receipt. Without service, it changes only HyperFlow database state and requires enabled runtime guards; suspend requires an independently fetched Communications suspension receipt. No file/provider cleanup or HyperFlow erasure is implied.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative app-owned result; not proof of an external provider effect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, role or membership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version conflict or held operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request budget exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operation",
                  "revision"
                ],
                "properties": {
                  "operation": {
                    "enum": [
                      "create_client",
                      "rotate_client",
                      "revoke_client",
                      "budget"
                    ]
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "pattern": "^[a-zA-Z0-9_-]{32,256}$"
                  },
                  "expiresAt": {
                    "type": "number",
                    "description": "Unix milliseconds, within 366 days"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "dailyLimit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                },
                "description": "Creation requires requestId/name/secret/expiresAt/scopes. Rotation requires id/secret/expiresAt. Revocation requires id. Budget requires dailyLimit. Revision is the current control ledger revision. Identical creation/rotation replay is safe."
              }
            }
          }
        },
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lifecycle"
              ]
            },
            "required": false
          }
        ]
      }
    },
