{
  "openapi": "3.1.0",
  "info": {
    "title": "HyperFlow Phase 01 authorization supplement",
    "version": "1.0.0",
    "description": "Supplement to docs/API.md; not a complete API listing."
  },
  "paths": {
    "/api/send-email": {
      "post": {
        "description": "Authenticated organization and project required. Backend email grant must allow_send; draft-only returns 403.",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted communication; not proof of delivery"
          },
          "403": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/execute": {
      "post": {
        "description": "Verify project belongs to authenticated organization before task execution. Email send actions respect backend ceiling.",
        "security": [
          {
            "FirebaseBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "taskType",
                  "correlation"
                ],
                "properties": {
                  "taskType": {
                    "type": "string"
                  },
                  "correlation": {
                    "type": "object",
                    "required": [
                      "projectId"
                    ],
                    "properties": {
                      "projectId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "orgId": {
                        "type": "string",
                        "description": "Selector verified against caller membership"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task result; pending flag may indicate asynchronous work"
          },
          "400": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "FirebaseBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
